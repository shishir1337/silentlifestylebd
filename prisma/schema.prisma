// Silent Lifestyle BD — data model
//
// Conventions used throughout:
//
//  * Money is Int, in whole BDT. The storefront already rounds every amount
//    (src/lib/currency.ts) and Bangladeshi retail does not price in paisa.
//    Float would introduce rounding error; Decimal would return a class
//    instance that complicates serialisation for no benefit here.
//  * `position` columns exist wherever display order is editable in the admin.
//    The current data files encode order implicitly by array index — that order
//    is meaningful (the category rail is merchandised) and must survive.
//  * Content the client edits is soft-controlled with `isActive` rather than
//    deleted, so an accidental removal is one click to undo.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block. The connection string for
// migrate/introspect now lives in `prisma.config.ts`, and the runtime client
// gets an explicit driver adapter (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Media
// ===========================================================================

/// Uploaded image, stored on ImageKit.
///
/// A table rather than a URL column on each record, because images are
/// deliberately shared: pakistani-stitched.jpg is currently used by a category,
/// a product and a promo tile at once.
///
/// `width`/`height`/`blurDataURL` are not optional decoration — static imports
/// supply them today, and next/image needs them to reserve layout space and
/// render the blur placeholder. Dropping them reintroduces layout shift.
model Asset {
  id             String   @id @default(cuid())
  imagekitFileId String   @unique
  url            String
  /// ImageKit path, kept so the file can be deleted or re-transformed later.
  filePath       String
  width          Int
  height         Int
  blurDataURL    String?
  /// Default alt text. Per-use alt overrides live on the referencing row.
  alt            String?
  bytes          Int
  mimeType       String
  createdAt      DateTime @default(now())

  categories    Category[]
  productImages ProductImage[]
  heroDesktop   HeroSlide[]    @relation("HeroDesktop")
  heroMobile    HeroSlide[]    @relation("HeroMobile")
  promoTiles    PromoTile[]

  @@index([createdAt])
}

// ===========================================================================
// Catalog
// ===========================================================================

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// Short line under the name on category tiles.
  tagline   String?
  imageId   String?
  /// Which size chart this category's products are measured by.
  ///
  /// On the category rather than on the product, because that is how the
  /// charts are already written: "Shirts, t-shirts & polos" is one chart
  /// covering three categories. Per-product would mean choosing one every time
  /// a product is added, which is a step that gets forgotten — and the page it
  /// gets forgotten on is the one that needed the chart.
  ///
  /// Nullable, because most of this catalogue has no sizes at all. Watches,
  /// wallets, purses and bracelets come one size, and offering a size guide
  /// there promises information that does not exist.
  sizeChartId String?
  /// Order in the mobile category rail — merchandised, highest intent first.
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image       Asset?               @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// `SetNull`: deleting a chart loses the guide, never the category and every
  /// product in it.
  sizeChart   SizeChart?           @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  products    Product[]
  collections CategoryCollection[]

  @@index([position])
  @@index([isActive])
}

/// Curated sets that are not categories: men, women, accessories, new, offers,
/// bestsellers.
///
/// `kind` distinguishes membership by category (CATEGORY — men/women/accessories)
/// from membership by product attribute (RULE — new/offers/bestsellers, which
/// are derived from badge and compareAtPrice rather than stored).
model Collection {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  kind        CollectionKind
  /// For RULE collections: which rule. Null for CATEGORY collections.
  rule        CollectionRule?
  position    Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  categories CategoryCollection[]

  @@index([position])
}

enum CollectionKind {
  CATEGORY
  RULE
}

enum CollectionRule {
  NEW
  ON_OFFER
  BESTSELLER
}

/// Join table for CATEGORY collections.
///
/// Required, not incidental: the current code keeps three overlapping hardcoded
/// Sets (MEN/WOMEN/ACCESSORY_CATEGORIES) where `watches` belongs to both men and
/// accessories. `Category.group` — a single enum column — cannot express that,
/// which is why it exists in the type today but is never read at runtime.
model CategoryCollection {
  categoryId   String
  collectionId String
  position     Int    @default(0)

  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([categoryId, collectionId])
  @@index([collectionId, position])
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  sku             String        @unique
  categoryId      String
  /// Selling price, whole BDT.
  price           Int
  /// Was-price. Set only when genuinely discounted — an inflated was-price is
  /// the thing the storefront copy explicitly promises not to do.
  compareAtPrice  Int?
  /// Plain text, derived from `descriptionRich` on every save.
  ///
  /// Kept as its own column because three things want words without markup:
  /// search, the meta description, and the structured data a crawler reads.
  /// Deriving it means the client edits one thing, not two that drift.
  description     String
  /// Formatted description: blocks and marks, never HTML. See `lib/rich-text`.
  ///
  /// Null for products written before the editor existed; the storefront falls
  /// back to `description` for those, so nothing had to be migrated.
  descriptionRich Json?
  badge           ProductBadge?
  /// Overrides the global free-delivery threshold for this item.
  freeDelivery    Boolean       @default(false)
  isActive        Boolean       @default(true)
  position        Int           @default(0)
  /// Optional SEO overrides; fall back to name/description when null.
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  details    ProductDetail[]
  variants   ProductVariant[]
  colors     ProductColor[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([badge])
  @@index([position])
}

enum ProductBadge {
  NEW
  BESTSELLER
  LIMITED
}

/// The scannable spec bullets (fabric, fit, construction, care).
/// A table rather than String[] so the admin can reorder and add rows.
model ProductDetail {
  id        String @id @default(cuid())
  productId String
  text      String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// Per-size stock — the capability the storefront does not have today.
///
/// A product with no sizes still gets exactly one variant (size ""), so every
/// stock read goes through the same path and there is no second code branch for
/// "sizeless" products.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  /// "M", "40", or "" for products sold without a size.
  size          String
  stock         Int     @default(0)
  /// Variant SKU. Falls back to the product SKU when null.
  sku           String?
  /// Rarely used; null means "same as the product price".
  priceOverride Int?
  position      Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId, position])
}

/// Display-only colour labels. Deliberately not inventory-bearing: the current
/// product page tracks a colour selection but never attaches it to the cart
/// line, and per-colour stock was explicitly ruled out of scope.
model ProductColor {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  assetId   String
  role      ProductImageRole @default(GALLERY)
  /// Per-use alt override; falls back to Asset.alt then the product name.
  alt       String?
  position  Int              @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([productId, position])
}

enum ProductImageRole {
  /// The card and gallery lead image.
  PRIMARY
  /// Revealed on card hover/focus.
  HOVER
  GALLERY
}

// ===========================================================================
// Identity
//
// better-auth owns User / Session / Account / Verification. Its Prisma adapter
// expects these exact model and field names, so they are written out rather
// than renamed to house style.
// ===========================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Contact numbers, not credentials. A Bangladeshi shop reaches a customer by
  /// phone — the courier calls before delivery — so these sit on the account
  /// rather than being retyped at every checkout. better-auth owns the columns
  /// above; these two are ours and it ignores them.
  phone    String?
  altPhone String?

  /// Null for ordinary shoppers. Any non-null value grants admin access, so
  /// this is the single most security-sensitive column in the schema.
  staffRole StaffRole?

  sessions    Session[]
  accounts    Account[]
  addresses   CustomerAddress[]
  orders      Order[]
  orderEvents OrderEvent[]
  auditEvents AuditEvent[]

  @@index([staffRole])
}

enum StaffRole {
  /// Everything, including staff management and settings.
  OWNER
  /// Catalog, orders and content. No staff or settings.
  MANAGER
  /// Orders only.
  STAFF
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  /// Hashed by better-auth. Null for OAuth-only accounts.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Saved delivery addresses for signed-in customers.
///
/// The storefront enforces "exactly one default, always" in the browser today
/// (src/lib/account.ts). Postgres cannot express "exactly one true per user" as
/// a plain constraint, so the partial unique index below enforces *at most* one,
/// and the server action promotes a replacement when the default is deleted.
model CustomerAddress {
  id        String       @id @default(cuid())
  userId    String
  /// What the customer calls it — "Home", "Office".
  label     String
  recipient String
  phone     String
  address   String
  area      DeliveryArea
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeliveryArea {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

// ===========================================================================
// Orders
// ===========================================================================

/// A placed order.
///
/// Customer contact details are snapshotted rather than joined: an order must
/// still show the address it was actually shipped to after the customer edits
/// their address book. `customerId` is null for guest checkout, which stays the
/// default path.
model Order {
  id            String      @id @default(cuid())
  /// Human-readable, read aloud over the phone: SLB-YYMMDD-XXXX.
  orderNo       String      @unique
  status        OrderStatus @default(PENDING)
  /// Whether this order's goods are currently back on the shelf.
  ///
  /// Not derived from the status. An order can be moved anywhere from
  /// anywhere — cancelled and then reinstated, returned and then marked
  /// delivered again — and the stock has to follow without ever being restored
  /// or taken twice. The status says where the order is; this says what has
  /// actually been done to inventory, which is the only safe thing to compare
  /// the next move against.
  stockRestored Boolean     @default(false)

  customerId String?

  // --- contact snapshot
  customerName  String
  customerPhone String
  altPhone      String?
  address       String
  note          String?
  area          DeliveryArea

  // --- money, all recomputed server-side at placement, never trusted from the client
  subtotal       Int
  /// Taken off the goods. Zero for a free-delivery coupon, which zeroes the
  /// charge instead — recording both would count the same saving twice.
  discount       Int           @default(0)
  deliveryCharge Int
  /// subtotal - discount + deliveryCharge. Stored rather than derived, because
  /// it is what the delivery man collects and must not change if a rule does.
  total          Int
  paymentMethod  PaymentMethod @default(COD)

  couponId   String?
  /// The code as typed, kept even if the coupon is later deleted. An order
  /// that cannot say why it was cheaper is an order nobody can explain.
  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]

  @@index([status, placedAt])
  @@index([customerId])
  /// Guest order lookup is by order number plus phone.
  @@index([customerPhone])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  /// Parked, on purpose, with the goods still reserved.
  ///
  /// The state a cash-on-delivery shop is actually in most often: the customer
  /// did not pick up, or asked to be called back tomorrow, or the address needs
  /// checking. Without it those orders sit in PENDING for days, which makes the
  /// "waiting to be confirmed" count — the one number the shop works from each
  /// morning — a list of orders nobody can act on.
  ///
  /// Deliberately not a restocking status. A held order is still the customer's;
  /// putting the goods back would sell them to somebody else while the shop is
  /// still trying to reach the first buyer.
  ON_HOLD
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
}

/// A line on an order.
///
/// Name, price, size and image are snapshotted at purchase time — the cart
/// already denormalises these today, which is correct: renaming or repricing a
/// product must not rewrite history on an order already placed.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  /// Nullable so deleting a product does not destroy order history.
  productId String?
  variantId String?

  name      String
  size      String?
  /// Which colour the customer picked. Display-only — it is not a stock
  /// dimension — but it is what has to go in the parcel, so it is recorded
  /// here rather than left on the page they chose it from.
  color     String?
  unitPrice Int
  qty       Int
  imageUrl  String
  /// Kept so the confirmation page can still link to the product.
  slug      String

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Append-only audit trail. Never updated, never deleted — it is the record of
/// who changed what, which is the whole reason staff have individual logins.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  note       String?
  /// Null for system-generated events such as order placement.
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ===========================================================================
// Site content — everything the client edits without a developer
// ===========================================================================

/// Scalar settings: delivery rates, free-delivery threshold, phone, address.
///
/// Key-value rather than a one-row table so adding a setting needs no migration.
/// `type` tells the admin form which control to render and how to parse.
/// Who changed what, outside orders.
///
/// `OrderEvent` already records every status change on an order, and proved
/// its worth the first time two people disagreed about who cancelled one.
/// This is the same idea for the things that have no order to hang off:
/// settings, staff roles, and the page and content edits.
///
/// The actor's name is copied in rather than joined. An audit trail that goes
/// blank when someone's account is removed is not an audit trail, and this is
/// the one table where a deleted staff member must still be nameable.
model AuditEvent {
  id        String   @id @default(cuid())
  /// Dotted verb, e.g. `settings.updated`, `staff.granted`, `staff.revoked`.
  action    String
  /// What was acted on: a setting key, a user id, a page slug.
  subject   String
  /// Written for the person reading the log, not assembled from columns later.
  summary   String
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

/// The strip above the header.
///
/// Two facts were hardcoded here: cash on delivery, and free delivery over a
/// threshold. Rows instead, because the strip is where a shop puts the thing
/// that is true this week — a festival delivery cut-off, a campaign, a warning
/// that Dhaka traffic is slow before Eid — and none of that is worth a deploy.
/// A discount code.
///
/// Everything about what a coupon is worth lives here and is applied on the
/// server at placement. The browser is told what a code *would* be worth so
/// the customer can see it, but that quote is a courtesy: the order is priced
/// again from these rows, the way the line prices already are.
model Coupon {
  id   String     @id @default(cuid())
  /// Uppercased on save. Customers type it in any case and on a phone.
  code String     @unique
  kind CouponKind

  /// PERCENT: 1–100. FIXED: whole taka off the goods. FREE_DELIVERY: unused.
  value Int

  /// Goods subtotal required before it applies at all. 0 = no minimum.
  minSpend    Int @default(0)
  /// Caps a percentage, e.g. "20% off, up to ৳500". 0 = uncapped.
  maxDiscount Int @default(0)

  /// Total redemptions allowed. 0 = unlimited.
  usageLimit    Int @default(0)
  /// Redemptions so far. Incremented inside the order transaction, guarded
  /// against the limit, so a race cannot spend the last one twice.
  usageCount    Int @default(0)
  /// Redemptions allowed per phone number. 0 = unlimited.
  ///
  /// Phone rather than account: most of this shop's orders are guests, and a
  /// per-account limit on a shop where accounts are optional limits nobody.
  perPhoneLimit Int @default(1)

  startsAt DateTime?
  endsAt   DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([code])
}

enum CouponKind {
  PERCENT
  FIXED
  FREE_DELIVERY
}

model Announcement {
  id String @id @default(cuid())

  /// The words.
  ///
  /// May contain placeholders, which are replaced at render time from the
  /// settings: `{free-over}`, `{inside-dhaka}`, `{outside-dhaka}`,
  /// `{return-days}`, `{phone}`. That is the difference between a strip that
  /// says "free over Tk 3,000" and one that still says it after the threshold
  /// has been changed to 4,000 — this shop has been bitten by copies of the
  /// same number before.
  text String

  icon AnnouncementIcon @default(NONE)
  /// Optional: makes the item a link, e.g. to the delivery page.
  href String?

  /// Shown only where there is room. The strip is one line, and three messages
  /// on a 360px phone is three unreadable ones.
  wideOnly  Boolean  @default(false)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

enum AnnouncementIcon {
  NONE
  CASH
  TRUCK
  RETURN
  SHIELD
}

model Setting {
  key       String      @id
  value     String
  type      SettingType @default(STRING)
  /// Groups settings into admin form sections.
  group     String      @default("general")
  label     String
  helpText  String?
  position  Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@index([group, position])
}

enum SettingType {
  STRING
  INT
  BOOLEAN
  TEXT
}

/// Homepage carousel banner.
///
/// All wording lives inside the artwork, so `alt` is the only machine-readable
/// copy — it carries the headline for screen readers and search engines, and is
/// required for that reason.
///
/// Both images are required and their dimensions are fixed (desktop 1920x600,
/// mobile 1000x700). Slides of differing ratios change the carousel track
/// height mid-scroll, so the admin validates dimensions on upload.
model HeroSlide {
  id             String   @id @default(cuid())
  desktopAssetId String
  mobileAssetId  String
  alt            String
  href           String
  /// Short label for the dot control, e.g. "New season".
  label          String
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  desktopAsset Asset @relation("HeroDesktop", fields: [desktopAssetId], references: [id], onDelete: Restrict)
  mobileAsset  Asset @relation("HeroMobile", fields: [mobileAssetId], references: [id], onDelete: Restrict)

  @@index([position])
  @@index([isActive])
}

/// The two editorial tiles under the bestsellers rail.
model PromoTile {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  href      String
  cta       String
  assetId   String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([position])
}

/// Editable content pages: delivery, returns, privacy, terms, about, stores,
/// contact. Slugs match existing routes, which render the stored body.
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  lead           String?
  /// Ordered blocks: sections, each holding paragraphs and bullet lists.
  ///
  /// Structured rather than HTML, which is what this column first specified.
  /// HTML would need a sanitiser on every save, would let a stray tag break
  /// the page layout, and would throw away the storefront's own Section and
  /// Bullets components — the very things that keep these pages looking like
  /// the rest of the shop. Blocks map onto those components exactly, so the
  /// editor cannot produce something the design cannot render.
  body           Json
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  /// Policy pages show "last updated"; a real date beats a hardcoded string.
  updatedAt      DateTime @updatedAt

  @@index([slug])
}

/// Size chart. Column count varies per chart (3-5) and cells mix text and
/// numbers ("M", 38, 27.5), so cells are stored as strings and rendered
/// verbatim. Typing them more strictly would buy nothing and break the shoe
/// chart, which mixes EU, UK and centimetres.
model SizeChart {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  note      String
  columns   String[]
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  rows       SizeChartRow[]
  categories Category[]

  @@index([position])
}

model SizeChartRow {
  id       String   @id @default(cuid())
  chartId  String
  cells    String[]
  position Int      @default(0)

  chart SizeChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId, position])
}

/// Header and footer navigation.
model NavItem {
  id        String   @id @default(cuid())
  group     NavGroup
  label     String
  href      String
  /// Renders in the sale colour — currently used for "Offers".
  highlight Boolean  @default(false)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([group, position])
}

enum NavGroup {
  PRIMARY
  HELP
  COMPANY
}
