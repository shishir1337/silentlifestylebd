# ---------------------------------------------------------------------------
# Silent Lifestyle BD — environment
#
# Copy to `.env` and fill in. Never commit `.env` itself.
#   cp .env.example .env
#
# Values marked BUILD-TIME are baked into the image by `next build`. Changing
# them requires a rebuild, not just a restart.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Inside Docker Compose the host is the service name (`db`), not localhost.
# Running Prisma from your machine against the compose stack? Use localhost:5432.
POSTGRES_USER=slbd
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=slbd
DATABASE_URL=postgresql://slbd:change-me-in-production@db:5432/slbd?schema=public

# --- Redis -----------------------------------------------------------------
# Used by better-auth as rate-limit storage (sign-in/sign-up abuse protection).
REDIS_URL=redis://cache:6379

# --- Auth ------------------------------------------------------------------
# Generate: openssl rand -base64 32
# better-auth rejects placeholder secrets in production and warns below 32 chars.
BETTER_AUTH_SECRET=
# Public origin of the site. Must be https:// in production.
BETTER_AUTH_URL=http://localhost:3000

# --- Who is behind the proxy -----------------------------------------------
# The hops in front of this app, as a comma-separated list of IPs or CIDRs.
# Every rate limit in the shop — sign-in, order placement, order tracking,
# discount-code guessing — identifies the caller by walking `X-Forwarded-For`
# from the right and skipping these. Get it wrong in one direction and a
# forged header defeats every limit; wrong in the other and all visitors share
# one bucket.
#
# Leave blank for the normal setup (reverse proxy on the same host, or a
# sibling container): loopback and the private ranges Docker allocates from
# are trusted by default. Set it when the proxy is elsewhere — a separate
# machine, or a CDN, in which case use that provider's published egress ranges.
TRUSTED_PROXIES=

# --- Next.js ---------------------------------------------------------------
# BUILD-TIME. Must be identical across every container and stable across
# deploys, or clients hit "Failed to find Server Action" after a release.
# Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Public site URL, used for canonical URLs, sitemap and JSON-LD.
# BUILD-TIME: NEXT_PUBLIC_* values are inlined by `next build`, so one image
# cannot serve two environments with different values here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ImageKit --------------------------------------------------------------
# Media pipeline. The private key is server-only and must never be exposed.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
