{
  "name": "silentlifestylebd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db cache",
    "db:down": "docker compose stop db cache",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning prisma/seed.mts",
    "db:studio": "prisma studio",
    "admin:grant": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/grant-staff.mts",
    "admin:create": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/create-owner.mts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "1.7.4",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.2.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@imagekit/nodejs": "^7.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
